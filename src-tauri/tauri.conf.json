{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BuildWipe",
  "version": "0.1.1",
  "identifier": "com.dshar.buildwipe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BuildWipe",
        "width": 1120,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "additionalBrowserArgs": "--disable-gpu --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self' 'unsafe-inline' http://localhost:1420 http://127.0.0.1:1420; font-src 'self' http://localhost:1420 http://127.0.0.1:1420; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwMDA1OEY2NzkwODFFNDcKUldSSEhnaDU5bGdBRUJJcWh0cytCVlRlVElEMHFLUDVsdmFmRmxja3RJbEhocjJ4cG1TTFdmNXkK",
      "endpoints": ["https://github.com/2001abhishek/BuildWipe/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
